{
  "audit": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "schema_version",
      "scan_scope",
      "rejected_count",
      "notes",
      "candidates"
    ],
    "properties": {
      "schema_version": {
        "type": "string",
        "enum": [
          "1"
        ]
      },
      "scan_scope": {
        "type": "string"
      },
      "rejected_count": {
        "type": "integer"
      },
      "notes": {
        "type": [
          "string",
          "null"
        ]
      },
      "candidates": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "candidate_id",
            "category",
            "title",
            "related_files",
            "problem",
            "minimal_change",
            "observable_contracts",
            "static_reachability",
            "dynamic_reachability",
            "external_consumer_risk",
            "ui_impact",
            "persistence_impact",
            "async_side_effect_impact",
            "test_protection",
            "characterization_needed",
            "estimated_file_count",
            "primary_symbol",
            "risk_level",
            "readiness",
            "evidence"
          ],
          "properties": {
            "candidate_id": {
              "type": "string"
            },
            "category": {
              "type": "string",
              "enum": [
                "DEAD_CODE",
                "COMPATIBILITY_REMOVAL",
                "DEDUPLICATION",
                "LARGE_COMPONENT_SPLIT"
              ]
            },
            "title": {
              "type": "string"
            },
            "related_files": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "problem": {
              "type": "string"
            },
            "minimal_change": {
              "type": "string"
            },
            "observable_contracts": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "static_reachability": {
              "type": "string",
              "enum": [
                "NONE",
                "INTERNAL_ONLY",
                "EXPORTED_UNUSED",
                "EXPORTED_USED",
                "UNKNOWN"
              ]
            },
            "dynamic_reachability": {
              "type": "string",
              "enum": [
                "NONE",
                "REFLECTION_OR_DI",
                "STRING_KEYED",
                "ROUTE_OR_CONFIG",
                "UNKNOWN"
              ]
            },
            "external_consumer_risk": {
              "type": "string",
              "enum": [
                "NONE",
                "INTERNAL_PACKAGE",
                "PUBLIC_API",
                "UNKNOWN"
              ]
            },
            "ui_impact": {
              "type": "string",
              "enum": [
                "NONE",
                "VISUAL_ONLY",
                "BEHAVIORAL",
                "UNKNOWN"
              ]
            },
            "persistence_impact": {
              "type": "string",
              "enum": [
                "NONE",
                "READ_PATH",
                "WRITE_PATH",
                "SCHEMA",
                "UNKNOWN"
              ]
            },
            "async_side_effect_impact": {
              "type": "string",
              "enum": [
                "NONE",
                "ORDERING",
                "TIMING",
                "CONCURRENCY",
                "UNKNOWN"
              ]
            },
            "test_protection": {
              "type": "string",
              "enum": [
                "NONE",
                "PARTIAL",
                "STRONG",
                "UNKNOWN"
              ]
            },
            "characterization_needed": {
              "type": "boolean"
            },
            "estimated_file_count": {
              "type": "integer"
            },
            "primary_symbol": {
              "type": [
                "string",
                "null"
              ]
            },
            "risk_level": {
              "type": "string",
              "enum": [
                "L0_LOW",
                "L1_MODERATE",
                "L2_HIGH",
                "L3_CRITICAL",
                "UNKNOWN"
              ]
            },
            "readiness": {
              "type": "string",
              "enum": [
                "READY",
                "NEEDS_EVIDENCE",
                "REJECT"
              ]
            },
            "evidence": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "file",
                  "locator",
                  "kind",
                  "supports"
                ],
                "properties": {
                  "file": {
                    "type": "string"
                  },
                  "locator": {
                    "type": "string"
                  },
                  "kind": {
                    "type": "string",
                    "enum": [
                      "GREP_HIT",
                      "GREP_ABSENCE",
                      "DEFINITION",
                      "EXPORT",
                      "TEST",
                      "CONFIG",
                      "GIT_HISTORY"
                    ]
                  },
                  "supports": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "maxItems": 8
      }
    }
  },
  "deepcheck": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "schema_version",
      "candidate_id",
      "category",
      "title",
      "minimal_change",
      "allowlist",
      "forbidden_files",
      "contracts",
      "stop_conditions",
      "rollback",
      "risk_level",
      "characterization_needed",
      "characterization_files",
      "readiness",
      "readiness_reason",
      "notes"
    ],
    "properties": {
      "schema_version": {
        "type": "string",
        "enum": [
          "1"
        ]
      },
      "candidate_id": {
        "type": "string"
      },
      "category": {
        "type": "string",
        "enum": [
          "DEAD_CODE",
          "COMPATIBILITY_REMOVAL",
          "DEDUPLICATION",
          "LARGE_COMPONENT_SPLIT"
        ]
      },
      "title": {
        "type": "string"
      },
      "minimal_change": {
        "type": "string"
      },
      "allowlist": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "forbidden_files": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "contracts": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "contract_id",
            "statement",
            "kind",
            "verified_by"
          ],
          "properties": {
            "contract_id": {
              "type": "string"
            },
            "statement": {
              "type": "string"
            },
            "kind": {
              "type": "string",
              "enum": [
                "SIGNATURE",
                "RETURN_SHAPE",
                "SIDE_EFFECT",
                "ORDERING",
                "ERROR_BEHAVIOR",
                "RENDER_OUTPUT",
                "PERSISTED_SHAPE"
              ]
            },
            "verified_by": {
              "type": "string"
            }
          }
        }
      },
      "stop_conditions": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "rollback": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "strategy",
          "detail"
        ],
        "properties": {
          "strategy": {
            "type": "string",
            "enum": [
              "GIT_RESET_HARD",
              "DISCARD_WORKTREE"
            ]
          },
          "detail": {
            "type": "string"
          }
        }
      },
      "risk_level": {
        "type": "string",
        "enum": [
          "L0_LOW",
          "L1_MODERATE",
          "L2_HIGH",
          "L3_CRITICAL",
          "UNKNOWN"
        ]
      },
      "characterization_needed": {
        "type": "boolean"
      },
      "characterization_files": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "readiness": {
        "type": "string",
        "enum": [
          "READY",
          "NEEDS_EVIDENCE",
          "REJECT"
        ]
      },
      "readiness_reason": {
        "type": "string"
      },
      "notes": {
        "type": [
          "string",
          "null"
        ]
      }
    }
  },
  "preflight": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "schema_version",
      "candidate_id",
      "verdict",
      "failure_hypothesis",
      "falsification_method",
      "falsification_result",
      "blocking_reasons",
      "notes"
    ],
    "properties": {
      "schema_version": {
        "type": "string",
        "enum": [
          "1"
        ]
      },
      "candidate_id": {
        "type": "string"
      },
      "verdict": {
        "type": "string",
        "enum": [
          "READY_TO_EXECUTE",
          "BLOCKED"
        ]
      },
      "failure_hypothesis": {
        "type": "string"
      },
      "falsification_method": {
        "type": "string"
      },
      "falsification_result": {
        "type": "string",
        "enum": [
          "SURVIVED",
          "FALSIFIED",
          "INCONCLUSIVE"
        ]
      },
      "blocking_reasons": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "code",
            "detail",
            "file"
          ],
          "properties": {
            "code": {
              "type": "string",
              "enum": [
                "DYNAMIC_REFERENCE_FOUND",
                "EXTERNAL_CONSUMER",
                "NO_TEST_PROTECTION",
                "CONTRACT_UNCLEAR",
                "SCOPE_TOO_LARGE",
                "BASELINE_UNSTABLE",
                "EVIDENCE_STALE"
              ]
            },
            "detail": {
              "type": "string"
            },
            "file": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        }
      },
      "notes": {
        "type": [
          "string",
          "null"
        ]
      }
    }
  },
  "characterization": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "schema_version",
      "candidate_id",
      "changed_files",
      "characterized_contracts",
      "production_source_changed",
      "assertions_weakened",
      "verdict",
      "notes"
    ],
    "properties": {
      "schema_version": {
        "type": "string",
        "enum": [
          "1"
        ]
      },
      "candidate_id": {
        "type": "string"
      },
      "changed_files": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "characterized_contracts": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "production_source_changed": {
        "type": "boolean"
      },
      "assertions_weakened": {
        "type": "boolean"
      },
      "verdict": {
        "type": "string",
        "enum": [
          "PASS",
          "FAIL"
        ]
      },
      "notes": {
        "type": [
          "string",
          "null"
        ]
      }
    }
  },
  "execute": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "schema_version",
      "candidate_id",
      "changed_files",
      "deleted_files",
      "rationale",
      "hunks",
      "verdict",
      "scope_expansion_required",
      "scope_expansion_reason",
      "notes"
    ],
    "properties": {
      "schema_version": {
        "type": "string",
        "enum": [
          "1"
        ]
      },
      "candidate_id": {
        "type": "string"
      },
      "changed_files": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "deleted_files": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "rationale": {
        "type": "string"
      },
      "hunks": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "hunk_id",
            "file",
            "classification",
            "justification",
            "contract_ids"
          ],
          "properties": {
            "hunk_id": {
              "type": "string"
            },
            "file": {
              "type": "string"
            },
            "classification": {
              "type": "string",
              "enum": [
                "INTERNAL_ONLY",
                "PROVEN_EQUIVALENT",
                "UNEXPLAINED",
                "CONTRACT_CHANGING"
              ]
            },
            "justification": {
              "type": "string"
            },
            "contract_ids": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      },
      "verdict": {
        "type": "string",
        "enum": [
          "PASS",
          "FAIL"
        ]
      },
      "scope_expansion_required": {
        "type": "boolean"
      },
      "scope_expansion_reason": {
        "type": [
          "string",
          "null"
        ]
      },
      "notes": {
        "type": [
          "string",
          "null"
        ]
      }
    }
  },
  "review": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "schema_version",
      "candidate_id",
      "verdict",
      "behavior_preservation_assessment",
      "unreviewable_hunks",
      "findings",
      "notes"
    ],
    "properties": {
      "schema_version": {
        "type": "string",
        "enum": [
          "1"
        ]
      },
      "candidate_id": {
        "type": "string"
      },
      "verdict": {
        "type": "string",
        "enum": [
          "PASS",
          "FAIL"
        ]
      },
      "behavior_preservation_assessment": {
        "type": "string",
        "enum": [
          "PRESERVED",
          "NOT_PRESERVED",
          "CANNOT_DETERMINE"
        ]
      },
      "unreviewable_hunks": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "findings": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "finding_id",
            "severity",
            "file",
            "locator",
            "claim",
            "why_it_matters",
            "suggested_action"
          ],
          "properties": {
            "finding_id": {
              "type": "string"
            },
            "severity": {
              "type": "string",
              "enum": [
                "BLOCKER",
                "HIGH",
                "MEDIUM",
                "LOW"
              ]
            },
            "file": {
              "type": "string"
            },
            "locator": {
              "type": "string"
            },
            "claim": {
              "type": "string"
            },
            "why_it_matters": {
              "type": "string"
            },
            "suggested_action": {
              "type": "string"
            }
          }
        }
      },
      "notes": {
        "type": [
          "string",
          "null"
        ]
      }
    }
  }
}
